<Window x:Class="ReadCity.OrdersWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
        xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
        xmlns:local="clr-namespace:ReadCity"
        mc:Ignorable="d"
        Icon="Images/icon.ico"
        Title="Окна заказов" Height="450" Width="900">
    <Grid>
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="*"/>
        </Grid.RowDefinitions>

        <DockPanel Grid.Row="0" Background="#ABCFCE" LastChildFill="False" Height="65">
            <StackPanel Orientation="Horizontal" DockPanel.Dock="Left" Margin="15,0" VerticalAlignment="Center">
                <Image Source="Images/icon.png" Height="40" Stretch="Uniform" Margin="0,0,10,0"/>
                <TextBlock Text="Список заказов" FontSize="20" FontWeight="Bold" VerticalAlignment="Center"/>
            </StackPanel>

            <StackPanel Orientation="Horizontal" DockPanel.Dock="Right" Margin="15,0" VerticalAlignment="Center">
                <Button x:Name="AddOrderBtn" Content="Добавить заказ" Width="120" Height="30" 
                        Click="AddOrderBtn_Click" Visibility="Collapsed" Margin="0,0,10,0"/>
                <Button Content="Назад" Width="85" Height="30" Click="BackBtn_Click"/>
            </StackPanel>
        </DockPanel>

        <ListView x:Name="OrdersList" Grid.Row="1" Margin="10" BorderThickness="0"
          HorizontalContentAlignment="Stretch" MouseDoubleClick="OrdersList_MouseDoubleClick">
            <ListView.ItemTemplate>
                <DataTemplate>
                    <Border BorderBrush="Black" BorderThickness="1" Background="White" Padding="10" Margin="0,0,0,8">
                        <Grid>
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="150"/>
                                <ColumnDefinition Width="*"/>
                                <ColumnDefinition Width="100"/>
                                <ColumnDefinition Width="100"/>
                            </Grid.ColumnDefinitions>

                            <StackPanel Grid.Column="0">
                                <TextBlock Text="{Binding Code, StringFormat=Код: {0}}" FontWeight="Bold"/>
                                <TextBlock Text="{Binding StatusName, StringFormat=Статус: {0}}"/>
                            </StackPanel>

                            <StackPanel Grid.Column="1" Margin="12,0">
                                <TextBlock Text="{Binding PickupPointAddress, StringFormat=Адрес: {0}}" TextWrapping="Wrap"/>
                                <TextBlock Text="{Binding OrderDate, StringFormat=Дата заказа: {0:dd.MM.yyyy}}"/>
                                <TextBlock Text="{Binding DeliveryDate, StringFormat=Дата выдачи: {0:dd.MM.yyyy}}"/>
                                <TextBlock Text="{Binding ArticlesText, StringFormat=Товары: {0}}" TextWrapping="Wrap"/>
                            </StackPanel>
                            <Button Content="Удалить" Width="80" Height="25" Foreground="Red" 
                            Grid.Column="2" VerticalAlignment="Center"
                            Click="DeleteOrder_Click" Tag="{Binding Id}"/>
                        </Grid>
                    </Border>
                </DataTemplate>
            </ListView.ItemTemplate>
        </ListView>
    </Grid>
</Window>
