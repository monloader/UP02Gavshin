<Window x:Class="ReadCity.OrderAddWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
        xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
        xmlns:local="clr-namespace:ReadCity"
        mc:Ignorable="d"
        Icon="Images/icon.ico"
        Title="OrderAddWindow" Height="450" Width="800">
    <Grid Margin="15">
        <Grid.RowDefinitions>
            <RowDefinition Height="*"/>
            <RowDefinition Height="Auto"/>
        </Grid.RowDefinitions>

        <StackPanel Grid.Row="0">
            <TextBlock Text="Товар (артикул):" FontWeight="Bold"/>
            <ComboBox x:Name="ProductBox" DisplayMemberPath="Article" SelectedValuePath="Id" Margin="0,5,0,10"/>

            <TextBlock Text="Количество:" FontWeight="Bold"/>
            <TextBox x:Name="QuantityBox" Margin="0,5,0,10" Text="1"/>
            <TextBlock Text="Статус заказа:" FontWeight="Bold"/>
            <ComboBox x:Name="StatusBox" DisplayMemberPath="Name" SelectedValuePath="Id" Margin="0,5,0,10"/>

            <TextBlock Text="Пункт выдачи:" FontWeight="Bold"/>
            <ComboBox x:Name="PickupBox" DisplayMemberPath="FullAddress" SelectedValuePath="Id" Margin="0,5,0,10"/>

            <TextBlock Text="Дата заказа:" FontWeight="Bold"/>
            <DatePicker x:Name="OrderDatePicker" Margin="0,5,0,10"/>

            <TextBlock Text="Дата выдачи:" FontWeight="Bold"/>
            <DatePicker x:Name="DeliveryDatePicker" Margin="0,5,0,10"/>
        </StackPanel>

        <StackPanel Grid.Row="1" Orientation="Horizontal" HorizontalAlignment="Right" Margin="0,15,0,0">
            <Button Content="Сохранить" Width="100" Height="30" Margin="0,0,10,0" Click="SaveBtn_Click"/>
            <Button Content="Отмена" Width="100" Height="30" Click="CancelBtn_Click"/>
        </StackPanel>
    </Grid>
</Window>
