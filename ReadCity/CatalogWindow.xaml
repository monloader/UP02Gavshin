<Window x:Class="ReadCity.CatalogWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
        xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
        xmlns:local="clr-namespace:ReadCity"
        mc:Ignorable="d"
        Icon="Images/icon.ico"
        Title="Каталог товаров" Height="650" Width="900">
    <Grid>
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="*"/>
        </Grid.RowDefinitions>

        <DockPanel Grid.Row="0" Background="#ABCFCE" LastChildFill="False" Height="65">
            <StackPanel Orientation="Horizontal" DockPanel.Dock="Left" Margin="15,0" VerticalAlignment="Center">
                <Image Source="Images/icon.png" Height="40" Stretch="Uniform" Margin="0,0,10,0"/>
                <TextBlock Text="Список товаров" FontSize="20" FontWeight="Bold" VerticalAlignment="Center"/>
            </StackPanel>

            <StackPanel Orientation="Horizontal" DockPanel.Dock="Right" Margin="15,0" VerticalAlignment="Center">
                <TextBlock x:Name="FioText" FontSize="14" VerticalAlignment="Center" Margin="0,0,15,0"/>
                <Button x:Name="OrdersBtn" Content="Заказы" Width="85" Height="30" 
            Click="OrdersBtn_Click" Visibility="Collapsed" Margin="0,0,10,0"/>
                <Button Content="Выйти" Width="85" Height="30" Click="Logout_Click"/>
            </StackPanel>
        </DockPanel>

        <Border Grid.Row="1" Background="#F0F0F0" Padding="10" Margin="10,10,10,0">
            <StackPanel x:Name="FilterPanel" Orientation="Horizontal" Visibility="Collapsed">
                <TextBlock Text="Поиск:" VerticalAlignment="Center" Margin="0,0,5,0"/>
                <TextBox x:Name="SearchBox" Width="200" TextChanged="SearchBox_TextChanged" Margin="0,0,15,0"/>

                <TextBlock Text="Сортировка:" VerticalAlignment="Center" Margin="0,0,5,0"/>
                <ComboBox x:Name="SortBox" Width="180" SelectionChanged="SortBox_SelectionChanged" Margin="0,0,15,0">
                    <ComboBoxItem Content="Без сортировки" IsSelected="True"/>
                    <ComboBoxItem Content="Цена (возрастание)"/>
                    <ComboBoxItem Content="Цена (убывание)"/>
                    <ComboBoxItem Content="Количество (возрастание)"/>
                    <ComboBoxItem Content="Количество (убывание)"/>
                </ComboBox>

                <TextBlock Text="Скидка:" VerticalAlignment="Center" Margin="0,0,5,0"/>
                <ComboBox x:Name="DiscountBox" Width="150" SelectionChanged="DiscountBox_SelectionChanged">
                    <ComboBoxItem Content="Все диапазоны" IsSelected="True"/>
                    <ComboBoxItem Content="0 - 12,99%"/>
                    <ComboBoxItem Content="13 - 16,99%"/>
                    <ComboBoxItem Content="17% и более"/>
                </ComboBox>

                <Button x:Name="AddProductBtn" Content="Добавить товар" Click="AddProductBtn_Click" 
                        Visibility="Collapsed" Width="120" Margin="15,0,0,0"/>
            </StackPanel>
        </Border>

        <ListView x:Name="ProductsList" Grid.Row="2" Margin="10" BorderThickness="0"
                  HorizontalContentAlignment="Stretch" ScrollViewer.HorizontalScrollBarVisibility="Disabled" MouseDoubleClick="ProductsList_MouseDoubleClick">
            <ListView.ItemTemplate>
                <DataTemplate>
                    <Border BorderBrush="Black" BorderThickness="1" Background="{Binding CardColor}" Padding="10" Margin="0,0,0,8">
                        <Grid>
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="130"/>
                                <ColumnDefinition Width="*"/>
                                <ColumnDefinition Width="110"/>
                            </Grid.ColumnDefinitions>
                            <Border Grid.Column="0" BorderBrush="Gray" BorderThickness="1" Width="115" Height="115" Background="White">
                                <Image Source="{Binding PhotoPath}" Stretch="Uniform"/>
                            </Border>

                            <StackPanel Grid.Column="1" Margin="12,0">
                                <TextBlock FontWeight="Bold" FontSize="14" TextWrapping="Wrap">
                                    <Run Text="{Binding CategoryName}"/>
                                    <Run Text=" | "/>
                                    <Run Text="{Binding Name}"/>
                                </TextBlock>
                                <TextBlock Text="{Binding Description, StringFormat=Описание товара: {0}}" TextWrapping="Wrap"/>
                                <TextBlock Text="{Binding ManufacturerName, StringFormat=Производитель: {0}}"/>
                                <TextBlock Text="{Binding SupplierName, StringFormat=Поставщик: {0}}"/>

                                <StackPanel Orientation="Horizontal">
                                    <TextBlock Text="Цена: "/>
                                    <TextBlock Text="{Binding OldPriceText}" Foreground="Red" TextDecorations="Strikethrough" Margin="0,0,6,0"/>
                                    <TextBlock Text="{Binding NewPriceText}" Foreground="Black"/>
                                </StackPanel>

                                <TextBlock Text="{Binding UnitName, StringFormat=Единица измерения: {0}}"/>
                                <TextBlock Text="{Binding Quantity, StringFormat=Количество на складе: {0}}"/>
                            </StackPanel>

                            <Border Grid.Column="2" BorderBrush="Gray" BorderThickness="1,0,0,0" Padding="8,0,0,0">
                                <StackPanel VerticalAlignment="Center" HorizontalAlignment="Center">
                                    <TextBlock Text="Действующая" HorizontalAlignment="Center"/>
                                    <TextBlock Text="скидка" HorizontalAlignment="Center"/>
                                    <TextBlock Text="{Binding Sale, StringFormat={}{0}%}" FontSize="18" FontWeight="Bold" HorizontalAlignment="Center"/>

                                    <Button Content="Удалить" Width="80" Height="25" 
        Margin="0,10,0,0" Foreground="Red"
        Click="DeleteProduct_Click" Tag="{Binding Id}">
                                        <Button.Style>
                                            <Style TargetType="Button">
                                                <Setter Property="Visibility" Value="Collapsed"/>
                                                <Style.Triggers>
                                                    <DataTrigger Binding="{Binding IsAdmin}" Value="True">
                                                        <Setter Property="Visibility" Value="Visible"/>
                                                    </DataTrigger>
                                                </Style.Triggers>
                                            </Style>
                                        </Button.Style>
                                    </Button>
                                </StackPanel>
                            </Border>
                        </Grid>
                    </Border>
                </DataTemplate>
            </ListView.ItemTemplate>
        </ListView>
    </Grid>
</Window>
